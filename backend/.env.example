# Copy to .env and replace values. Never commit .env.
# development = local only (dev-default secrets allowed, cookie not Secure).
# production  = default if unset; app REFUSES to start without strong, non-default secrets.
ENVIRONMENT=development
# Required in production: >=32 chars, random, different from each other.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ADMIN_SESSION_HOURS=8
DATABASE_URL=sqlite:///./healthtech.db
# Also the trusted-Origin list for CSRF checks on /admin/login and /admin/logout
CORS_ORIGINS=http://localhost:3000
# Used only by scripts/create_admin.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-pass
